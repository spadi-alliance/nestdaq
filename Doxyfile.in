PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@"
FILE_PATTERNS          = *.h *.hh *.hpp *.hxx *.c *.cc *.cpp *.cxx *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.git/* */build/* */install/*
MARKDOWN_SUPPORT       = YES
FILTER_PATTERNS        = *.md=@NESTDAQ_DOXYGEN_MERMAID_FILTER@
IMPLICIT_DIR_DOCS      = NO
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
EXTRACT_ALL            = YES
PREDEFINED             = __cplusplus

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
GENERATE_TREEVIEW      = YES
TOC_INCLUDE_HEADINGS   = 3

HTML_EXTRA_STYLESHEET  = @NESTDAQ_DOXYGEN_HTML_EXTRA_STYLESHEET@
HTML_EXTRA_FILES       = @NESTDAQ_DOXYGEN_HTML_EXTRA_FILES@
