#!/bin/bash

#NESTDAQ_TERM=xterm

# Redis host:port shared by the daq_service, metrics, and parameter_config
# plugins. The script maps those plugin roles to Redis DB 0, 1, and 2 below.
NESTDAQ_REDIS_SERVER=${NESTDAQ_REDIS_SERVER:-127.0.0.1:6379}
# Default OpenTelemetry Collector endpoint for host-local validation. Use
# otel-collector:4317 or clickstack:4317 when the device runs in the same
# compose network as those services.
NESTDAQ_OTLP_GRPC_ENDPOINT=${NESTDAQ_OTLP_GRPC_ENDPOINT:-localhost:4317}
# FairLogger console output is disabled by default so logs are not duplicated
# on stdout when OpenTelemetry log export is enabled.
NESTDAQ_FAIRLOGGER_CONSOLE_SEVERITY=${NESTDAQ_FAIRLOGGER_CONSOLE_SEVERITY:-nolog}
# OpenTelemetry log export has its own severity threshold. This is independent
# of the FairLogger console severity above.
NESTDAQ_START_DEVICE_OTEL_LOG_SEVERITY=${NESTDAQ_START_DEVICE_OTEL_LOG_SEVERITY:-info}

# Redis DB layout used by the helper scripts:
#   DB 0: daq_service registry, commands, and topology
#   DB 1: metrics plugin data
#   DB 2: parameter_config values
DAQSERVICE_URI=" --registry-uri tcp://${NESTDAQ_REDIS_SERVER}/0"
METRICS_URI=" --metrics-uri tcp://${NESTDAQ_REDIS_SERVER}/1"
CONFIG_URI=" --parameter-config-uri tcp://${NESTDAQ_REDIS_SERVER}/2"

#---------------------------------------------------------
if [[ $1 =~ fairmq- ]]; then
  BINDIR=""
else 
  BINDIR=@EX_BINDIR@
fi

PLUGIN_LIBDIR=@EX_LIBDIR@

# -S adds a plugin search path. The leading '<' asks FairMQ to prepend this
# directory to the search path; it does not load any plugin by itself.
PLUGIN_SEARCH_PATH=" -S '<$PLUGIN_LIBDIR'"
# Plugins are loaded by -P options in the order they appear on the final
# command line. Keep the intended order: daq_service, metrics, parameter_config.
DAQSERVICE_PLUGIN=" -P daq_service"
METRICS_PLUGIN=" -P metrics"
CONFIG_PLUGIN=" -P parameter_config"

echo "BINDIR             = $BINDIR"
echo "PLUGIN_LIBDIR      = $PLUGIN_LIBDIR"
echo "PLUGIN_SEARCH_PATH = $PLUGIN_SEARCH_PATH"
echo "DAQSERVICE_PLUGIN  = $DAQSERVICE_PLUGIN"
echo "METRICS_PLUGIN     = $METRICS_PLUGIN"
echo "CONFIG_PLUGIN      = $CONFIG_PLUGIN"
echo "NESTDAQ_REDIS_SERVER = $NESTDAQ_REDIS_SERVER"
echo "NESTDAQ_OTLP_GRPC_ENDPOINT = $NESTDAQ_OTLP_GRPC_ENDPOINT"
echo "NESTDAQ_FAIRLOGGER_CONSOLE_SEVERITY = $NESTDAQ_FAIRLOGGER_CONSOLE_SEVERITY"
echo "NESTDAQ_START_DEVICE_OTEL_LOG_SEVERITY = $NESTDAQ_START_DEVICE_OTEL_LOG_SEVERITY"
echo "DAQSERVICE_URI     = $DAQSERVICE_URI"
echo "METRICS_URI        = $METRICS_URI"
echo "CONFIG_URI         = $CONFIG_URI"

#==============================================================================
function run_device () {
  local var;
  # Add the plugin search path first, then list the plugins to load. FairMQ
  # loads the -P plugins in this order after resolving their libraries through
  # the -S search path.
  var+=$PLUGIN_SEARCH_PATH
  var+=$DAQSERVICE_PLUGIN
  var+=$METRICS_PLUGIN
  var+=$CONFIG_PLUGIN
  var+=$DAQSERVICE_URI
  var+=$METRICS_URI
  var+=$CONFIG_URI

  # Device identity options such as --service-name are intentionally not set
  # here. Pass them after the device name, for example:
  #   ./start_device.sh Sampler --service-name A-Sampler
  var+=" --severity ${NESTDAQ_FAIRLOGGER_CONSOLE_SEVERITY}"

  # Export logs to the local OpenTelemetry Collector by default. Metrics and
  # traces are left as opt-in examples below.
  var+=" --otel-log-protocol=otlp-grpc"
  var+=" --otel-log-endpoint-grpc=${NESTDAQ_OTLP_GRPC_ENDPOINT}"
  var+=" --otel-log-severity=${NESTDAQ_START_DEVICE_OTEL_LOG_SEVERITY}"

  # FairLogger console output is disabled by default with --severity nolog.
  # To enable console output, run with, for example:
  # NESTDAQ_FAIRLOGGER_CONSOLE_SEVERITY=debug4 ./start_device.sh ...
  # OTel log export uses a separate threshold:
  # NESTDAQ_START_DEVICE_OTEL_LOG_SEVERITY=debug4 ./start_device.sh ...

  # To print OpenTelemetry logs to the console instead:
  #var+=" --otel-log-protocol=console"
  # To print logs both to the console and a local OpenTelemetry Collector:
  #var+=" --otel-log-protocol=console,otlp-grpc"
  # To disable OpenTelemetry logs explicitly:
  #var+=" --otel-log-protocol ''"
  # Metrics and traces are disabled by default. Uncomment these lines to export
  # them to the same local OpenTelemetry Collector by OTLP gRPC.
  #var+=" --otel-metric-protocol=otlp-grpc"
  #var+=" --otel-metric-endpoint-grpc=${NESTDAQ_OTLP_GRPC_ENDPOINT}"
  #var+=" --otel-trace-protocol=otlp-grpc"
  #var+=" --otel-trace-endpoint-grpc=${NESTDAQ_OTLP_GRPC_ENDPOINT}"
  # For console debugging of metrics and traces:
  #var+=" --otel-metric-protocol=console"
  #var+=" --otel-trace-protocol=console"

  if [ -n "$NESTDAQ_TERM" ]; then
    #echo \
    $NESTDAQ_TERM -title $1 -e "$BINDIR/$@ $var"
  else
    #echo \
    eval "$BINDIR/$@ $var"
  fi
}

run_device $@
